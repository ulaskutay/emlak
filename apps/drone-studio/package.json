  },
  "devDependencies": {
    "@types/google.maps": "^3.58.0",
    "@types/node": "^24.0.0",
    "playwright-core": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
