# --- RunPod ---
RUNPOD_API_KEY=
# Kendi video worker'ımız (gpu/video-worker)
RUNPOD_VIDEO_ENDPOINT_ID=
# hunyuan15_480p (48 GB, ucuz) | ltx2 (80 GB)
RUNPOD_MODEL_PROFILE=hunyuan15_480p
# Webhook: RunPod iş bitince buraya POST atar (orkestratörün public URL'i)
PUBLIC_WEBHOOK_URL=https://api.example.com/webhooks/runpod

# --- Mesai saati scaler (Europe/Istanbul) ---
SCALER_TIMEZONE=Europe/Istanbul
SCALER_WORK_START=8
SCALER_WORK_END=22
SCALER_ACTIVE_WORKERS_DAY=1
SCALER_ACTIVE_WORKERS_NIGHT=0
SCALER_MAX_WORKERS=8

# --- Seedance (BytePlus ModelArk) — premium paket ---
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=seedance-1-0-pro-250528

# --- Cloudflare R2 (S3 uyumlu) — worker çıktıyı doğrudan buraya yükler ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Boşsa worker 7 günlük imzalı link döndürür (bucket gizli kalır)
R2_PUBLIC_BASE_URL=

# --- Google Maps Platform (Maps JavaScript API + Map Tiles API + Elevation API) ---
# Tarayıcıda kullanılır: Google Cloud Console'da HTTP referrer kısıtlaması (localhost:5178) ekleyin.
GOOGLE_MAPS_API_KEY=

# İnşaat sahnesi endpointleri (aynı worker, farklı MODEL_FAMILY)
RUNPOD_QWEN_ENDPOINT_ID=
RUNPOD_WAN_ENDPOINT_ID=

# Drone render worker (gpu/drone-worker) — Google 3D harita, görünmez Chrome
RUNPOD_DRONE_ENDPOINT_ID=

# --- ElevenLabs (seslendirme, müzik, efekt) ---
ELEVENLABS_API_KEY=
# Boşsa hesaptaki Türkçe konuşabilen ilk uygun ses seçilir
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Panel (apps/web) + kuyruk ---
DATABASE_URL=postgres://user:pass@localhost:5432/arsa_video
REDIS_URL=redis://localhost:6379
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -hex 32
BETTER_AUTH_SECRET=
