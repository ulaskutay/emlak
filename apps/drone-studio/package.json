{
  "name": "@arsa/drone-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "tsx node_modules/vite/bin/vite.js build --mode web --base /studio/ --outDir ../web/public/studio --emptyOutDir",
    "record": "tsx scripts/record.ts",
    "still": "tsx scripts/still.ts",
    "typecheck": "tsc --noEmit",
    "reel": "tsx --env-file-if-exists=../../.env scripts/reel.ts",
    "voices": "tsx --env-file-if-exists=../../.env scripts/voices.ts"
  },
  "dependencies": {
    "@arsa/geo": "workspace:*",
    "@arsa/providers": "workspace:*",
    "@arsa/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.0",
    "@types/node": "^24.0.0",
    "playwright-core": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  },
  "exports": {
    "./story": "./scripts/story.ts",
    "./pipeline": "./scripts/pipeline.ts"
  }
}
