{
  "name": "arsa-video",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "scaler": "pnpm --filter @arsa/orchestrator scaler",
    "bench": "pnpm --filter @arsa/orchestrator bench",
    "listing-video": "pnpm --filter @arsa/orchestrator listing-video",
    "drone": "pnpm --filter @arsa/drone-studio record",
    "drone:dev": "pnpm --filter @arsa/drone-studio dev",
    "construction": "pnpm --filter @arsa/orchestrator construction",
    "drone-job": "pnpm --filter @arsa/orchestrator drone-job",
    "reel": "pnpm --filter @arsa/drone-studio reel",
    "voices": "pnpm --filter @arsa/drone-studio voices",
    "web": "pnpm --filter @arsa/web dev",
    "worker": "pnpm --filter @arsa/worker dev",
    "db:generate": "pnpm --filter @arsa/db generate",
    "db:migrate": "pnpm --filter @arsa/db migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
